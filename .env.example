# Copy to .env (or .env.local) and fill in. Every VITE_* value is embedded in
# the browser bundle at build time -- never put secrets here. (The chatbot's AI
# key lives on the backend as GEMINI_API_KEY, not in this app.)

# Base URL of the EverZone REST API (backend branch). A trailing "/api" is
# optional; both the storefront and /admin use this single value.
# Production (Vercel): https://api-everzone.khantmaung.com
# If unset, `npm run dev` uses http://localhost:5000.
VITE_API_BASE_URL=http://localhost:5000
