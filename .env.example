# Copy to .env (git-ignored) and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development
# HOST=0.0.0.0

# PostgreSQL: either a single connection URL (preferred) ...
DATABASE_URL=postgres://postgres:change-me@localhost:5432/everzone_db
# ... or the discrete settings below (used only when DATABASE_URL is empty).
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=everzone_db
# DB_USER=postgres
# DB_PASSWORD=change-me
# Set to true for hosted Postgres that requires TLS (Render, Neon, Supabase...).
DB_SSL=false

# JWT signing secret: required. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

# Comma-separated list of allowed browser origins (the EverZone web app).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional: seed the first superadmin on startup when the admins table is empty.
# Leave ADMIN_PASSWORD empty to skip seeding (then use POST /api/admin/register).
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
