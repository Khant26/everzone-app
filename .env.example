# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# In Docker, pass these as container environment variables instead.

PORT=5000
NODE_ENV=development
# HOST=0.0.0.0

# PostgreSQL: either a single connection URL (preferred) ...
#   production example: postgres://everzone:<password>@db:5432/everzone
DATABASE_URL=postgres://postgres:change-me@localhost:5432/everzone_db
# ... or the discrete settings below (used only when DATABASE_URL is empty).
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=everzone_db
# DB_USER=postgres
# DB_PASSWORD=change-me
# Set to true for hosted Postgres that requires TLS (Render, Neon, Supabase...).
DB_SSL=false
# Max pooled connections (keep small on a shared Postgres).
DB_POOL_MAX=5

# JWT signing secret: required (32+ chars in production). Generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

# Comma-separated list of allowed browser origins (the EverZone web app).
# Production: https://everzone.khantmaung.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# First superadmin, created on startup only when the admins table is empty.
# Leave ADMIN_PASSWORD empty to skip (then use POST /api/admin/register).
# Log in at /admin with ADMIN_EMAIL or ADMIN_USERNAME. Min 8 characters.
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# 1 = on startup, fill EMPTY tables with fictional demo content (categories,
# services, projects, sample inquiries). Never touches tables that have data.
SEED_DEMO=0

# Optional storefront chatbot (server-side proxy at POST /api/chat).
# Without a key the endpoint answers 503 and the site shows an offline reply.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
