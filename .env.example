# Copy to .env (or .env.local) and fill in. Every VITE_* value is embedded in
# the browser bundle at build time -- never put server secrets here.

# Base URL of the EverZone REST API (backend branch). A trailing "/api" is
# optional; both the storefront and /admin use this single value.
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: Google Gemini key for the storefront chatbot. This key is visible
# to anyone using the site, so restrict it (HTTP referrer + API restrictions)
# in Google Cloud Console. Leave empty to disable the chatbot replies.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash-lite
